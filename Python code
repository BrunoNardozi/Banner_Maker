### IMAGE MAKER ###
def image_maker(
    image_path,
    banner_size,
    program_folder,
    font_path,
    mapping,
    ref
):
    # Load and re-size image                                                                                       
    img = Image.open(image_path)                                                                               
    img = ImageOps.exif_transpose(img).convert("RGBA")
    orig_w, orig_h = img.size
    canvas = Image.new("RGBA", (orig_w, orig_h), (255, 255, 255, 255))
    new_w, new_h = int(orig_w * (1 - banner_size)), int(orig_h * (1 - banner_size))                              
    img_resized = img.resize((new_w, new_h), Image.LANCZOS)
    canvas.paste(img_resized, (0, orig_h - new_h), img_resized)

    # Load Icons and crop padding                                                                                 
    icon_folder = os.path.join(program_folder, "Icons")                                                          
    icon_names = ["ref.png", "typology.png", "location.png", "price.png", "area.png", "bedrooms.png"]
    icon_paths = [os.path.join(icon_folder, name) for name in icon_names]
    icons = []
    for path in icon_paths:
        icon = Image.open(path).convert("RGBA")  
        bbox = icon.getbbox()                   
        cropped_icon = icon      
        icons.append(cropped_icon)

    # Horizontal banner

    # Find available vertical and horizontal space (margins included)
    available_h = int((orig_h - new_h) * 0.80)
    available_w = int(orig_w * 0.90)

    # Find max font size 
    font_size = 200
    while font_size > 5:
        font = ImageFont.truetype(font_path, font_size)                                                            
        t1_h = font.getbbox(mapping[ref]["typology"])[3] - font.getbbox(mapping[ref]["typology"])[1]             
        t2_h = font.getbbox(mapping[ref]["location"])[3] - font.getbbox(mapping[ref]["location"])[1]
        text_h = max(t1_h, t2_h)
        t1_w = font.getbbox(mapping[ref]["typology"])[2] - font.getbbox(mapping[ref]["typology"])[0]
        t2_w = font.getbbox(mapping[ref]["location"])[2] - font.getbbox(mapping[ref]["location"])[0]
        icon1_w = int(icons[1].width * text_h * 0.8 / icons[1].height)
        icon2_w = int(icons[2].width * text_h * 0.8 / icons[2].height)
        small_space = int(font_size*0.2)
        big_space = (orig_w - t1_w - t2_w - icon1_w - icon2_w - small_space*2) // 3
        total_w = t1_w + t2_w + icon1_w + icon2_w + small_space*2 + big_space
        
        if text_h <= available_h and total_w <= available_w:
            break  
        font_size -= 1

    # References for centering 
    y = (orig_h - new_h) // 2  
    x = big_space

    # Icon xheights
    icon_h = int(text_h * 0.9)
    icon1_resized = icons[1].resize((int(icons[1].width * icon_h / icons[1].height), icon_h),Image.LANCZOS)
    icon2_resized = icons[2].resize((int(icons[2].width * icon_h / icons[2].height), icon_h),Image.LANCZOS)

    # Draw
    draw = ImageDraw.Draw(canvas)
    canvas.paste(icon1_resized, (x, y - icon1_resized.height // 2), icon1_resized)
    x += icon1_resized.width + small_space
    draw.text((x, y),mapping[ref]["typology"],font=font,fill=(0, 0, 0, 255), anchor="lm")
    x += t1_w + big_space
    canvas.paste(icon2_resized, (x, y - icon1_resized.height // 2), icon2_resized), 
    x += icon2_resized.width + small_space
    draw.text((x, y),mapping[ref]["location"],font=font,fill=(0, 0, 0, 255), anchor="lm")

    # Vertical banner

    # vb Find available vertical and horizontal space (margins included at 7,5% total vertical and horizontal space)
    vb_available_h = int(new_h * 0.90)
    vb_available_w = (orig_w - new_w) * 0.90

    # vb Find max font size 
    vb_font_size = 200
    while vb_font_size > 5:
        vb_font = ImageFont.truetype(font_path, vb_font_size)                                                             
        vb_t1_w = vb_font.getbbox(ref)[2] - vb_font.getbbox(ref)[0]
        vb_t2_w = vb_font.getbbox(mapping[ref]["price"])[2] - vb_font.getbbox(mapping[ref]["price"])[0]
        vb_text_h = vb_font.getbbox(ref)[3] - vb_font.getbbox(ref)[1]              # ref  FOLDER PROCESSOR INPUT
        vb_small_space = int(vb_font_size*0.2)
        vb_icon_h = vb_text_h * 0.8
        vb_big_space = int((vb_available_h - vb_t1_w*4 - vb_icon_h*4 - vb_small_space*4) // 5)
        vb_total_h = vb_text_h*4 + vb_icon_h*4 + vb_small_space*4 + vb_big_space*3 
        if max(vb_t1_w, vb_t2_w) <= vb_available_w and vb_total_h <= vb_available_h:
            break
        vb_font_size -= 1
    vb_font_size = min(vb_font_size, font_size)

    # vb References for centering 
    vb_y = (orig_h - new_h) + (new_h - vb_available_h)//3
    vb_x = new_w + (orig_w - new_w)//2

    # vb Icon heights
    vb_icon1_resized = icons[0].resize(icon1_resized.size,Image.LANCZOS)
    vb_icon2_resized = icons[3].resize(icon1_resized.size,Image.LANCZOS)
    vb_icon3_resized = icons[2].resize(icon1_resized.size,Image.LANCZOS)
    vb_icon4_resized = icons[2].resize(icon1_resized.size,Image.LANCZOS)
                    
    # Draw
    vb_draw = ImageDraw.Draw(canvas)
    canvas.paste(vb_icon1_resized, (vb_x - vb_icon1_resized.width // 2, vb_y), vb_icon1_resized)
    vb_y += vb_icon1_resized.height + small_space
    vb_draw.text((vb_x, vb_y),ref,font=vb_font,fill=(0, 0, 0, 255), anchor="mt")
    vb_y += vb_text_h + vb_big_space
    canvas.paste(vb_icon2_resized, (vb_x - vb_icon2_resized.width // 2, vb_y), vb_icon2_resized)
    vb_y += vb_icon2_resized.height + small_space
    vb_draw.text((vb_x, vb_y),mapping[ref]["price"],font=vb_font,fill=(0, 0, 0, 255), anchor="mt")
    vb_y += vb_text_h + vb_big_space
    canvas.paste(vb_icon3_resized, (vb_x - vb_icon3_resized.width // 2, vb_y), vb_icon3_resized)
    vb_y += vb_icon3_resized.height + small_space
    vb_draw.text((vb_x, vb_y),mapping[ref]["area"],font=vb_font,fill=(0, 0, 0, 255), anchor="mt")
    vb_y += vb_text_h + vb_big_space
    canvas.paste(vb_icon4_resized, (vb_x - vb_icon4_resized.width // 2, vb_y), vb_icon4_resized)
    vb_y += vb_icon3_resized.height + small_space
    vb_draw.text((vb_x, vb_y),mapping[ref]["bedrooms"],font=vb_font,fill=(0, 0, 0, 255), anchor="mt")

    return canvas



### FOLDER PROCESSOR ###

def folder_processor(
    mother_folder,
    banner_size,
    program_folder,
    font_path,
    mapping
):
    # create output mother folder
    output_mother_folder = mother_folder + "_banner"
    os.makedirs(output_mother_folder, exist_ok=True)

    # checks if input folder name is a ref
    for ref in mapping.keys():
        src_folder = os.path.join(mother_folder, ref)
        if not os.path.isdir(src_folder):
            continue

        # create output ref folder
        dst_folder = os.path.join(output_mother_folder, f"{ref}_banner")
        os.makedirs(dst_folder, exist_ok=True)

        # check for images in input ref folder
        for filename in os.listdir(src_folder):
            if not filename.lower().endswith((".jpg", ".jpeg", ".png", ".webp")):
                continue

            # creates banner image and saves in output ref folder
            image_path = os.path.join(src_folder, filename)

            canvas = image_maker(
                image_path,
                banner_size,
                program_folder,
                font_path,
                mapping,
                ref
            )

            output_path = os.path.join(dst_folder, filename)

            if output_path.lower().endswith((".jpg", ".jpeg")):
                canvas = canvas.convert("RGB")

            canvas.save(output_path)




